# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Smitvi Media

# Database
# Local default (SQLite). For production, use PostgreSQL:
# DATABASE_URL="postgresql://smitvi:smitvi@localhost:5432/smitvi_media?schema=public"
DATABASE_URL="file:./dev.db"

# Auth — generate a long random string (32+ chars)
AUTH_SECRET=change-me-to-a-long-random-secret

# Seeded admin (used by `npm run db:seed`)
ADMIN_EMAIL=admin@smitvimedia.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_USERNAME=admin

# Official brand creator
OFFICIAL_CREATOR_EMAIL=hello@smitvimedia.com
OFFICIAL_CREATOR_PASSWORD=change-this-creator-password

# Uploads
UPLOAD_MAX_BYTES=524288000
UPLOAD_MAX_SHORT_BYTES=157286400
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3-compatible object storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# Optional CDN origin prepended to public media URLs
CDN_BASE_URL=

# Analytics
ANALYTICS_VIEW_DEDUP_HOURS=6
